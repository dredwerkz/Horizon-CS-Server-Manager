# Horizon CS Server Manager - Environment Configuration
# Copy this file to .env and set your actual values
# The .env file is gitignored and should never be committed

# =============================================================================
# Docker Configuration (required for docker-compose)
# =============================================================================

# PostgreSQL Database Password
# Used by both the postgres service and the app service
POSTGRES_PASSWORD=your_secure_password_here

# pgAdmin Configuration (Development Only)
# Used when running with --profile dev flag
PGADMIN_EMAIL=admin@horizon.local
PGADMIN_PASSWORD=your_pgadmin_password_here

# =============================================================================
# WebSocket Configuration (optional - for custom network setups)
# =============================================================================

# Override the WebSocket host if needed (defaults to current hostname)
# REACT_APP_WS_HOST=192.168.1.100

# Override the WebSocket port if needed (defaults to 5000)
# REACT_APP_WS_PORT=5000
